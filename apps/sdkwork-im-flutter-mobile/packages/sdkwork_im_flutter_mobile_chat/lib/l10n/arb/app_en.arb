{
  "@@locale": "en",
  "inboxTitle": "Inbox",
  "@inboxTitle": {
    "description": "Title of the chat inbox screen listing conversations."
  },
  "liveBadge": "Live",
  "@liveBadge": {
    "description": "Badge shown in the app bar while the realtime connection is live."
  },
  "conversationFallbackTitle": "Conversation",
  "@conversationFallbackTitle": {
    "description": "Fallback title for an inbox conversation entry that has no display name."
  },
  "inboxEmpty": "No conversations yet.",
  "@inboxEmpty": {
    "description": "Empty-state text shown when the inbox has no conversations."
  },
  "inboxLoadError": "Unable to load conversations.",
  "@inboxLoadError": {
    "description": "Error shown when loading an inbox page fails."
  },
  "inboxPageRetainError": "Unable to retain the requested conversation page.",
  "@inboxPageRetainError": {
    "description": "Error shown when a fetched conversation page cannot be merged into the inbox window."
  },
  "retry": "Retry",
  "@retry": {
    "description": "Button label to retry a failed inbox load."
  },
  "loadMore": "Load more",
  "@loadMore": {
    "description": "Button label that loads the next page of inbox conversations."
  },
  "conversationTitleFallback": "Conversation {conversationId}",
  "@conversationTitleFallback": {
    "description": "Fallback app bar title for a conversation screen when no title is provided.",
    "placeholders": {
      "conversationId": {
        "type": "String"
      }
    }
  },
  "messagesEmpty": "No messages yet.",
  "@messagesEmpty": {
    "description": "Empty-state text shown when a conversation has no messages."
  },
  "messagePageRetainError": "Unable to retain the requested message page.",
  "@messagePageRetainError": {
    "description": "Error shown when a fetched message page cannot be merged into the history window."
  },
  "earlierMessagePageRetainError": "Unable to retain the earlier message page.",
  "@earlierMessagePageRetainError": {
    "description": "Error shown when an older message page cannot be merged into the history window."
  },
  "failedToLoadMessages": "Failed to load messages: {error}",
  "@failedToLoadMessages": {
    "description": "Error shown when loading the message history fails; includes the failure detail.",
    "placeholders": {
      "error": {
        "type": "String"
      }
    }
  },
  "failedToLoadEarlierMessages": "Failed to load earlier messages: {error}",
  "@failedToLoadEarlierMessages": {
    "description": "Error shown when loading older message history fails; includes the failure detail.",
    "placeholders": {
      "error": {
        "type": "String"
      }
    }
  },
  "failedToSendMessage": "Failed to send message: {error}",
  "@failedToSendMessage": {
    "description": "Snackbar text shown when sending a message fails; includes the failure detail.",
    "placeholders": {
      "error": {
        "type": "String"
      }
    }
  },
  "failedToUploadImage": "Failed to upload image: {error}",
  "@failedToUploadImage": {
    "description": "Snackbar text shown when uploading an image fails; includes the failure detail.",
    "placeholders": {
      "error": {
        "type": "String"
      }
    }
  },
  "composerHint": "Type a message",
  "@composerHint": {
    "description": "Hint text of the message composer input field."
  },
  "send": "Send",
  "@send": {
    "description": "Label of the button that sends the composed message."
  },
  "sending": "Sending…",
  "@sending": {
    "description": "Label of the send button while a message is being sent."
  }
}
