    }
  },
  "dependencies": {
    "@sdkwork/account-app-sdk": "workspace:*",
    "@sdkwork/agents-app-sdk": "workspace:*",
    "@sdkwork/drive-app-sdk": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/im-sdk": "workspace:*",
    "@sdkwork/knowledgebase-app-sdk": "workspace:*",
    "@sdkwork/order-app-sdk": "workspace:*",
    "@sdkwork/sdk-common": "catalog:",
