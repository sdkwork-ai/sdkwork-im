{
  "//": [
    "Sibling-repo type scoping (PNPM_WORKSPACE_DEPENDENCY_SPEC: consumers",
    "typecheck their own program; siblings are consumed via their public",
    "types). The packages scoped under compilerOptions.paths below publish raw",
    "TS sources (exports -> ./src/index.ts) and ship no dist declarations, so",
    "importing them pulled the sibling's whole source graph into this program",
    "and surfaced the sibling's own type debt (uninstalled sibling deps,",
    "implicit anys, duplicate i18next majors) as H5 errors. `exclude` cannot",
    "fix that (imported files enter the program regardless) and skipLibCheck",
    "only skips .d.ts, so each graph is snapshotted to consumer-owned",
    "declarations generated from the sibling's real sources. These paths",
    "entries scope TYPECHECK only: scripts/dev/run-tsx-cli.mjs strips",
    "types/siblings scopes for test runs so runtime keeps resolving the real",
    "workspace packages through node_modules, and Vite builds never read this",
    "tsconfig (aliases resolve the real sources). `types/siblings` is excluded",
    "so snapshots are never program roots. The snapshots are generated",
    "locally and git-ignored (`**/types/siblings/`); regenerate them with",
    "the //regen command below after a sibling's public surface changes."
  ],
  "//regen": "node scripts/dev/gen-sibling-type-decls.mjs --app apps/sdkwork-im-h5 --out types/siblings --package @sdkwork/rtc-h5-call --package @sdkwork/order-app-sdk --package @sdkwork/community-mobile-react-community --package @sdkwork/i18n-pc-react",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@sdkwork/rtc-h5-call": [
        "./types/siblings/@sdkwork/rtc-h5-call/src/index.d.ts"
      ],
      "@sdkwork/rtc-h5-call/*": [
        "./types/siblings/@sdkwork/rtc-h5-call/src/*"
      ],
      "@sdkwork/order-app-sdk": [
        "./types/siblings/@sdkwork/order-app-sdk/src/index.d.ts"
      ],
      "@sdkwork/order-app-sdk/*": [
        "./types/siblings/@sdkwork/order-app-sdk/src/*"
      ],
      "@sdkwork/community-mobile-react-community": [
        "./types/siblings/@sdkwork/community-mobile-react-community/src/index.d.ts"
      ],
      "@sdkwork/community-mobile-react-community/*": [
        "./types/siblings/@sdkwork/community-mobile-react-community/src/*"
      ],
      "@sdkwork/i18n-pc-react": [
        "./types/siblings/@sdkwork/i18n-pc-react/src/index.d.ts"
      ],
      "@sdkwork/i18n-pc-react/*": [
        "./types/siblings/@sdkwork/i18n-pc-react/src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/client": [
        "./node_modules/@types/react-dom/client.d.ts"
      ],
      "react-router-dom": [
        "./node_modules/react-router-dom/dist/index.d.ts"
      ],
      "react-router": [
        "./node_modules/react-router/dist/development/index.d.ts"
      ],
      "lucide-react": [
        "./node_modules/lucide-react/dist/lucide-react.d.ts"
      ],
      "motion/react": [
        "./node_modules/motion/dist/react.d.ts"
      ],
      "clsx": [
        "./node_modules/clsx/clsx.d.mts"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge/dist/types.d.ts"
      ],
      "zustand": [
        "./node_modules/zustand/index.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/@types/react/jsx-dev-runtime"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@sdkwork/sdk-common": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/index.ts"
      ],
      "@sdkwork/sdk-common/*": [
        "../../../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "node_modules.*",
    ".vite",
    "tmp",
    "target",
    "vc-minify-test.mjs",
    "types/siblings"
  ]
}
