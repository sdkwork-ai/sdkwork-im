{
  "name": "@sdkwork/im-pc-chat",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@sdkwork/agents-pc-agents": "workspace:*",
    "@sdkwork/im-pc-commons": "workspace:*",
    "@sdkwork/im-pc-core": "workspace:*",
    "@sdkwork/im-pc-shell": "workspace:*",
    "@sdkwork/im-pc-token-plan": "workspace:*",
    "@sdkwork/im-sdk": "workspace:*",
    "@sdkwork/membership-pc-subscription": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "@sdkwork/rtc-sdk": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "@sdkwork/im-pc-types": "workspace:*",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "react-markdown": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@sdkwork/im-pc-community": "workspace:*",
    "i18next": "catalog:",
    "react-router-dom": "catalog:",
    "@sdkwork/notary-pc-core": "workspace:*",
    "@sdkwork/im-pc-workspace": "workspace:*",
    "@sdkwork/drive-upload-image-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./embed-surfaces": {
      "types": "./src/embed-surfaces.ts",
      "import": "./src/embed-surfaces.ts",
      "default": "./src/embed-surfaces.ts"
    },
    "./embed-services": {
      "types": "./src/embed-services.ts",
      "import": "./src/embed-services.ts",
      "default": "./src/embed-services.ts"
    },
    "./embed-chrome": {
      "types": "./src/embed-chrome.ts",
      "import": "./src/embed-chrome.ts",
      "default": "./src/embed-chrome.ts"
    },
    "./conversation-list": {
      "types": "./src/components/ChatList.tsx",
      "import": "./src/components/ChatList.tsx",
      "default": "./src/components/ChatList.tsx"
    },
    "./chat-window": {
      "types": "./src/components/ChatWindow.tsx",
      "import": "./src/components/ChatWindow.tsx",
      "default": "./src/components/ChatWindow.tsx"
    },
    "./contacts-directory": {
      "types": "./src/pages/ContactsView.tsx",
      "import": "./src/pages/ContactsView.tsx",
      "default": "./src/pages/ContactsView.tsx"
    }
  },
  "files": [
    "src",
    "README.md"
  ]
}
