{
  "name": "@sdkwork/im-pc-embed",
  "version": "1.0.0",
  "type": "module",
  "description": "Embeddable SDKWork IM PC surfaces: host-injected environment and session with the IM product UI reused as-is.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@sdkwork/im-pc-chat": "workspace:*",
    "@sdkwork/im-pc-core": "workspace:*",
    "@sdkwork/im-pc-types": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./full": {
      "types": "./src/full.ts",
      "import": "./src/full.ts",
      "default": "./src/full.ts"
    },
    "./providers": {
      "types": "./src/surfaces/ImPcSurfaceProviders.tsx",
      "import": "./src/surfaces/ImPcSurfaceProviders.tsx",
      "default": "./src/surfaces/ImPcSurfaceProviders.tsx"
    },
    "./conversation-list": {
      "types": "./src/surfaces/ImConversationListSurface.tsx",
      "import": "./src/surfaces/ImConversationListSurface.tsx",
      "default": "./src/surfaces/ImConversationListSurface.tsx"
    },
    "./chat": {
      "types": "./src/surfaces/ImChatSurface.tsx",
      "import": "./src/surfaces/ImChatSurface.tsx",
      "default": "./src/surfaces/ImChatSurface.tsx"
    },
    "./contacts": {
      "types": "./src/surfaces/ImContactsSurface.tsx",
      "import": "./src/surfaces/ImContactsSurface.tsx",
      "default": "./src/surfaces/ImContactsSurface.tsx"
    }
  },
  "files": [
    "src",
    "README.md"
  ]
}
