# Sdkwork IM PC renderer — optional local overrides.
# Full stack development uses repository-root topology profiles:
#   pnpm dev
#   pnpm dev:desktop

# Application ingress (default from etc/topology/standalone.development.env)
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18089
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18089

# Platform API gateway (IAM, Drive, Agent, Notary) — collapsed to application ingress in standalone dev
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:18089
VITE_SDKWORK_IAM_APP_API_BASE_URL=http://127.0.0.1:18089

# Standalone Knowledgebase browser application used by the group header. Its
# pathname must match Knowledgebase's own VITE_SDKWORK_KNOWLEDGEBASE_BROWSER_BASE_PATH.
# The launch ticket is passed only in the URL fragment, never in query params.
VITE_SDKWORK_KNOWLEDGEBASE_APP_URL=http://127.0.0.1:5184

# Optional: disable Vite HMR during automated edits
# DISABLE_HMR=true

# Public application access token (required; public SaaS-isolation material).
# The committed per-profile value lives in `.env.<profile-id>` and is
# materialized by `pnpm workflow:materialize-client-env`.
SDKWORK_ACCESS_TOKEN=

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
