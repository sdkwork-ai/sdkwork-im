{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-im-mini-program",
    "displayName": "Sdkwork IM Mini Program",
    "version": "0.1.0",
    "type": "mini-program-app-root",
    "root": "apps/sdkwork-im-mini-program",
    "domain": "communication",
    "capability": "chat",
    "surface": "app",
    "languages": [
      "typescript"
    ],
    "generated": false,
    "manifests": [
      "package.json",
      "sdkwork.app.config.json",
      "project.config.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "MINI_PROGRAM_APP_ARCHITECTURE_SPEC.md",
      "path": "../../../sdkwork-specs/MINI_PROGRAM_APP_ARCHITECTURE_SPEC.md",
      "purpose": "Mini program application root architecture."
    },
    {
      "file": "APP_CLIENT_ARCHITECTURE_ALIGNMENT_SPEC.md",
      "path": "../../../sdkwork-specs/APP_CLIENT_ARCHITECTURE_ALIGNMENT_SPEC.md",
      "purpose": "Cross-client package taxonomy and dependency direction."
    },
    {
      "file": "APP_COMPOSITION_SPEC.md",
      "path": "../../../sdkwork-specs/APP_COMPOSITION_SPEC.md",
      "purpose": "Native-authority application composition."
    },
    {
      "file": "APP_SDK_INTEGRATION_SPEC.md",
      "path": "../../../sdkwork-specs/APP_SDK_INTEGRATION_SPEC.md",
      "purpose": "Generated app SDK integration."
    },
    {
      "file": "CODE_STYLE_SPEC.md",
      "path": "../../../sdkwork-specs/CODE_STYLE_SPEC.md",
      "purpose": "Authored source structure and generated code boundaries."
    },
    {
      "file": "NAMING_SPEC.md",
      "path": "../../../sdkwork-specs/NAMING_SPEC.md",
      "purpose": "Canonical SDKWork naming rules."
    }
  ],
  "contracts": {
    "publicExports": [
      "."
    ],
    "runtimeEntrypoints": [
      "src/app.js"
    ],
    "sdkClients": [
      "@sdkwork/im-sdk",
      "@sdkwork/im-app-sdk",
      "@sdkwork/iam-app-sdk"
    ],
    "sdkDependencies": [
      "sdkwork-im-sdk",
      "sdkwork-im-app-sdk",
      "sdkwork-iam-app-sdk"
    ],
    "permissionComposition": {
      "inheritanceMode": "module-catalog-with-overrides",
      "moduleCatalogRefs": [
        {
          "moduleId": "im",
          "manifestRef": "../../../specs/iam.module.manifest.json",
          "inheritPermissions": true,
          "inheritRoles": true
        }
      ],
      "bootstrapAccessTokenScope": {
        "inheritFrom": "sdkwork.app.config.json#backend.accessTokenPermissionScope",
        "supplement": [],
        "overrideReplace": false
      },
      "routePermissionHints": {
        "inheritFromOpenApi": true,
        "inheritFromModuleManifests": true,
        "overrides": []
      },
      "consumerPolicy": {
        "forbidLocalPermissionCatalogForDependencyDomains": true,
        "allowExplicitOverridesOnly": true,
        "allowFrontendHintsWithoutServerDuplication": true
      },
      "applicationModule": {
        "manifestRef": "../../../specs/iam.module.manifest.json"
      }
    }
  },
  "verification": {
    "commands": [
      "node ../sdkwork-specs/tools/check-apps-directory-index.mjs --root ..",
      "node --test apps/sdkwork-im-mini-program/tests/mini-program-surface-contract.test.mjs",
      "node --test apps/sdkwork-im-mini-program/tests/mini-program-runtime-config.test.mjs",
      "node --test apps/sdkwork-im-mini-program/tests/mini-program-route-projection.test.mjs",
      "node --test apps/sdkwork-im-mini-program/tests/mini-program-env-alignment.test.mjs"
    ]
  }
}
