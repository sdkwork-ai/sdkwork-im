.login-page {
  justify-content: center;
  padding: 0 48rpx;
}

.login-page__header {
  display: flex;
  flex-direction: column;
  margin-bottom: 64rpx;
}

.login-page__title {
  font-size: 44rpx;
  font-weight: 600;
  color: #181818;
}

.login-page__description {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #888888;
}

.login-page__body {
  display: flex;
  flex-direction: column;
}

.login-page__action {
  background-color: #0f766e;
  color: #ffffff;
}

.login-page__error {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #fa5151;
  word-break: break-all;
}
