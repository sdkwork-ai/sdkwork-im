.inbox-page {
  background-color: #f5f5f5;
}

.inbox-page__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.inbox-page__toolbar-title {
  font-size: 28rpx;
  color: #888888;
}

.inbox-page__toolbar-action {
  font-size: 44rpx;
  line-height: 1;
  color: #0f766e;
  padding: 0 8rpx;
}

.inbox-page__error {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fa5151;
  word-break: break-all;
}

.inbox-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #ededed;
}

.inbox-row__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.inbox-row__avatar--placeholder {
  background-color: #ededed;
}

.inbox-row__body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.inbox-row__line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.inbox-row__name {
  font-size: 32rpx;
  color: #181818;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.inbox-row__time {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

.inbox-row__summary {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888888;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.inbox-row__badge {
  margin-left: 16rpx;
  min-width: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background-color: #fa5151;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.inbox-page__footer {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
}
