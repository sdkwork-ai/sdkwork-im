.contacts-page {
  padding-bottom: 32rpx;
}

.contacts-page__search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.contacts-page__search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #f2f3f5;
  font-size: 28rpx;
}

.contacts-page__search-action {
  font-size: 28rpx;
  color: #07c160;
}

.contacts-page__section {
  margin-top: 16rpx;
}

.contacts-page__section-title {
  display: block;
  padding: 0 24rpx 8rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.contacts-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.contacts-row__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.contacts-row__avatar--placeholder {
  background: #e3e4e8;
}

.contacts-row__body {
  flex: 1;
  min-width: 0;
}

.contacts-row__name {
  display: block;
  font-size: 30rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contacts-row__meta {
  display: block;
  font-size: 24rpx;
  color: #9a9a9a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contacts-row__action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #07c160;
}

.contacts-row__action--muted {
  color: #9a9a9a;
}

.contacts-page__footer {
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9a9a9a;
}
