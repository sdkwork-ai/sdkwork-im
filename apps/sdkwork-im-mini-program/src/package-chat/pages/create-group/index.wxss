.create-group-page {
  padding: 24rpx;
}

.create-group__field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background-color: #ffffff;
}

.create-group__label {
  font-size: 26rpx;
  color: #888888;
}

.create-group__input {
  margin-top: 16rpx;
  height: 72rpx;
  font-size: 30rpx;
  color: #181818;
}

.create-group__textarea {
  margin-top: 16rpx;
  width: 100%;
  height: 160rpx;
  font-size: 30rpx;
  color: #181818;
}

.create-group__actions {
  margin-top: 8rpx;
}

.create-group__submit {
  background-color: #0f766e;
  color: #ffffff;
}

.create-group__error {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #fa5151;
  word-break: break-all;
}

.create-group__picker {
  max-height: 420rpx;
  overflow-y: auto;
  border: 1rpx solid #e3e4e8;
  border-radius: 12rpx;
}

.create-group__pick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
}

.create-group__pick-check {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #c8c9cc;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.create-group__pick-check--on {
  background: #07c160;
  border-color: #07c160;
}

.create-group__pick-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.create-group__pick-id {
  font-size: 22rpx;
  color: #9a9a9a;
  margin-left: auto;
}
