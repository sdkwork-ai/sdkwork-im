/**
 * Message thread styles.
 *
 * The composer is pinned to the bottom and the history scrolls above it, so the
 * page itself never scrolls: `scroll-view` needs a bounded height to be
 * scrollable at all, and `flex: 1` inside the `.im-mp-page` column is what gives
 * it one.
 *
 * Bubble alignment is uniform on purpose. The wire contract
 * (`ConversationMessageEntry`) carries a sender but no "is this me" flag, so the
 * renderer has nothing honest to branch on; inventing a self bubble would mean
 * guessing the current user's id from a different endpoint.
 */

.conversation-page {
  height: 100vh;
  overflow: hidden;
}

.conversation-page__history {
  flex: 1;
  min-height: 0;
  padding: 16rpx 0;
}

.conversation-page__earlier {
  padding: 16rpx 32rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
}

.conversation-page__messages {
  padding: 0 24rpx;
}

.message-bubble {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message-bubble__sender {
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  color: #888888;
}

.message-bubble__text {
  max-width: 80%;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background-color: #ffffff;
  font-size: 30rpx;
  color: #181818;
  word-break: break-word;
}

.message-bubble__time {
  margin-top: 8rpx;
  padding-left: 4rpx;
  font-size: 22rpx;
  color: #888888;
}

.conversation-page__error {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fa5151;
  word-break: break-all;
}

.conversation-page__composer {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #ededed;
  /* Keeps the composer above the home indicator on notched devices. */
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.conversation-page__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background-color: #f5f5f5;
  font-size: 30rpx;
  color: #181818;
}

.conversation-page__send {
  margin-left: 16rpx;
  flex-shrink: 0;
  background-color: #0f766e;
  color: #ffffff;
}
