# sdkwork-im staging deployment inputs (deployments/docker/bundle/env uses the same template).
# Copy to staging.env and fill the placeholders before exposing beyond localhost.

# Release identity (RELEASE_SPEC.md §3): the image tag this environment runs.
SDKWORK_IM_IMAGE_TAG=0.1.0

# Fleet topology.
SDKWORK_IM_REPLICAS=1
SDKWORK_IM_STAGING_HOST_PORT=3972
SDKWORK_IM_DEPS_MODE=external
SDKWORK_IM_ID_NODE_ID=1

# Public ingress (browser CORS allow-list for the API plane).
SDKWORK_CORS_ALLOWED_ORIGINS=https://im-staging.sdkwork.com,http://im-staging.sdkwork.com,https://im-staging.birdcoder.com,http://im-staging.birdcoder.com,https://im-staging.dtupay.com,http://im-staging.dtupay.com,https://im-staging.noaper.com,http://im-staging.noaper.com,https://im-staging.sdkwork.cn,http://im-staging.sdkwork.cn,https://im-staging.birdcoder.cn,http://im-staging.birdcoder.cn,https://im-staging.dtupay.cn,http://im-staging.dtupay.cn,https://im-staging.noaper.cn,http://im-staging.noaper.cn,https://im-staging.skubc.com,http://im-staging.skubc.com,https://im-staging.skubc.cn,http://im-staging.skubc.cn,https://im-staging.zowalk.com,http://im-staging.zowalk.com,https://im-staging.zowalk.cn,http://im-staging.zowalk.cn,https://im-staging.offer86.com,http://im-staging.offer86.com,https://im-staging.offer86.cn,http://im-staging.offer86.cn,https://im-staging.86offer.com,http://im-staging.86offer.com,https://im-staging.86offer.cn,http://im-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

# Database (external host-system PostgreSQL by default; embedded mode reads
# IM_POSTGRES_PASSWORD from the bundle env file instead). The embedded
# knowledgebase database module requires the pgvector extension.
SDKWORK_DATABASE_HOST=host.docker.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_staging
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_staging
SDKWORK_DATABASE_USERNAME=sdkwork_ai_staging
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_DATABASE_SSL_MODE=require

# Redis (external host-system Redis by default).
SDKWORK_IM_REDIS_HOST=host.docker.internal
SDKWORK_IM_REDIS_PORT=6379
SDKWORK_IM_REDIS_PASSWORD=

# Observability floor (OPERATIONS_SPEC.md §2.1): DEBUG is development/test only.
RUST_LOG=info
