# sdkwork-im production deployment inputs (deployments/docker/bundle/env uses the same template).
# Copy to production.env and fill the placeholders before exposing beyond localhost.

# Release identity (RELEASE_SPEC.md §3): the image tag this environment runs.
SDKWORK_IM_IMAGE_TAG=0.1.0

# Fleet topology.
SDKWORK_IM_REPLICAS=1
SDKWORK_IM_PROD_HOST_PORT=3973
SDKWORK_IM_DEPS_MODE=external
SDKWORK_IM_ID_NODE_ID=5

# Public ingress (browser CORS allow-list for the API plane).
SDKWORK_CORS_ALLOWED_ORIGINS=https://im.sdkwork.com,https://im.birdcoder.com,https://im.dtupay.com,https://im.noaper.com,https://im.sdkwork.cn,https://im.birdcoder.cn,https://im.dtupay.cn,https://im.noaper.cn,https://im.skubc.com,https://im.skubc.cn,https://im.zowalk.com,https://im.zowalk.cn,https://im.offer86.com,https://im.offer86.cn,https://im.86offer.com,https://im.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

# Database (external host-system PostgreSQL by default; embedded mode reads
# IM_POSTGRES_PASSWORD from the bundle env file instead). The embedded
# knowledgebase database module requires the pgvector extension.
SDKWORK_DATABASE_HOST=host.docker.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_DATABASE_SSL_MODE=require

# Redis (external host-system Redis by default).
SDKWORK_IM_REDIS_HOST=host.docker.internal
SDKWORK_IM_REDIS_PORT=6379
SDKWORK_IM_REDIS_PASSWORD=

# Observability floor (OPERATIONS_SPEC.md §2.1): DEBUG is development/test only.
RUST_LOG=info
