# SDKWork cloud.production overrides (edit this file, not the resolved profile)
COMMUNITY_DEFAULT_TENANT_ID=100001
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1
SDKWORK_IM_PROFILE_ID=cloud.production
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api.sdkwork.com
SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.sdkwork.com
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.sdkwork.com
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_MAX_CONNECTIONS=32
SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/run/secrets/sdkwork/app-context-signature-secret
SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/run/secrets/sdkwork/jwt-signing-secret
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_IM_SESSION_GATEWAY_DRAIN_TIMEOUT_SECS=45
SDKWORK_IM_JWT_REPLAY_REDIS_URL=redis://redis.internal:6379/0
